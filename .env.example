# عنوان الـ endpoint على سيرفرك اللي بيرجّع ephemeral key لـ OpenAI Realtime API
# لازم يقبل POST ويرجّع JSON فيه: { "client_secret": { "value": "ek_..." } }
# لو سيرفرك على نفس الدومين: خليه زي ما هو
VITE_REALTIME_SESSION_URL=/api/realtime/session

# مثال لو على سيرفر تاني:
# VITE_REALTIME_SESSION_URL=https://api.tycoons-inv.com/realtime/session
