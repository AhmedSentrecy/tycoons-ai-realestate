# ── الصوت ──────────────────────────────────────────────────────────
# OpenAI Realtime (اختياري — محادثة صوتية حية):
# عنوان Netlify Function اللي بيكلم api.openai.com/v1/realtime/calls
# بمفتاح OpenAI المتخزن في Netlify (OPENAI_API_KEY). نفس بنية الموقع الحالي.
VITE_REALTIME_CONNECT_URL=/.netlify/functions/openai-realtime-connect

# لو الفانكشن مش متاحة، الموقع بيتحوّل تلقائيًا لـ:
#   STT: Web Speech API بالمتصفح
#   TTS: ElevenLabs عبر tts-proxy (نفس الموقع الحالي — مضبوط جوه الكود)

# مثال لو الفانكشن على دومين تاني:
# VITE_REALTIME_CONNECT_URL=https://tycoons-inv.com/.netlify/functions/openai-realtime-connect
