# ═══════════════════════════════════════════════════════════════
# متغيرات بيئة تايكونز — التصميم الجديد
# ═══════════════════════════════════════════════════════════════
#
# ① متغيرات الفرونت إند (Vite) — تتحط في Netlify UI أو ملف .env محلي
#    كل متغيرات Vite لازم تبدأ بـ VITE_ عشان تظهر في المتصفح
# ─────────────────────────────────────────────────────────────

# عنوان فانكشن OpenAI Realtime (محادثة صوتية حية)
# على Netlify تشتغل بالمسار المحلي زي ما هو — مفيش حاجة تتغير
VITE_REALTIME_CONNECT_URL=/.netlify/functions/openai-realtime-connect

# لو الفانكشن على دومين تاني:
# VITE_REALTIME_CONNECT_URL=https://tycoons-inv.com/.netlify/functions/openai-realtime-connect


# ─────────────────────────────────────────────────────────────
# ② متغيرات السيرفر (Netlify Functions) — تتحط في Netlify UI بس
#    Site settings → Environment variables — متتحطش في .env أبدًا
# ─────────────────────────────────────────────────────────────
#
# OPENAI_API_KEY          مفتاح OpenAI (sk-...) — بيستخدمه openai-realtime-connect
# OPENAI_REALTIME_MODEL   اختياري — الافتراضي: gpt-realtime-2.1
# OPENAI_REALTIME_VOICE   اختياري — الافتراضي: cedar
#
# ملاحظة: ElevenLabs TTS شغال عبر Supabase proxy بتاعكم
# (tts-proxy) — مفتاح ElevenLabs متخزن في Supabase مش هنا.
